clean:
	rm -f $(TARGETS) *.o $(DEPS) *.xcoff *.pef *.dsk *.bin *.APPL *.gdb


.o.xcoff:
	$(CC) -o $@ $< testutils.o $(LIBPATH) $(LIBS)
	mv $@ $*
	../../xcoff2app.sh $*
	rm $*

%.d : %.c
	@echo Making dependencies for $<
	@$(CC) -MM -MP -MT $(@:.d=.o) -o $@ $< $(CFLAGS)

%.o : %.c
	@echo Compiling $<
	$(CC) -o $@ -c $< $(CFLAGS)

# Load .d files
ifneq ($(MAKECMDGOALS),clean)
-include $(DEPS)
endif
