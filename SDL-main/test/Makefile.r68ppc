# Makefile to build the ppc SDL tests

PATH_TO_RETRO68=$(HOME)/Retro68-build/toolchain/powerpc-apple-macos

.SUFFIXES:	.xcoff

#CC=m68k-apple-macos-gcc
#CXX=m68k-apple-macos-g++
CC=powerpc-apple-macos-gcc
CXX=powerpc-apple-macos-g++

#CFLAGS = -mcrt=$(CRT) -gstabs -O3 -Wall -I../include -I../include/build_config -I../src -DHAVE_OPENGL
CFLAGS = -Wall -I../include -I../include/build_config -I../src
CFLAGS+= -D__MACOSCLASSIC__ -DSDL_MACOSCLASSIC_INPUTSPROCKET=1-DHAVE_OPENGL=1
#CFLAGS+= -DSDL_MACOSCLASSIC_TINYGL=1 

LIBS   = -L.. -lSDL3_test -lSDL3 ../../macos8addons/libmacos8addons.a 
LIBS+=-lOpenGLLibrary 
LIBS+=-lm -Wl,--relax -Wl,-Map,output.map -Wl,--gc-sections

RINC=$(PATH_TO_RETRO68)/RIncludes
#RES=$(RINC)/Retro68APPL.r
RES=$(RINC)/RetroPPCAPPL.r

SRC_FILES = $(wildcard *.c)
DEPS = $(SRC_FILES:.c=.d)


TARGETS = \
	checkkeys \
	childprocess \
	helloworld \
	loopwave \
	sdl3benchmark \
	testasyncio \
	testatomic \
	testaudio \
	testaudiohotplug \
	testaudioinfo \
	testaudiorecording \
	testaudiostreamdynamic \
	testautomation \
	testbounds \
	testclipboard \
	testcolorspace \
	testcontroller \
	testcustomcursor \
	testdialog \
	testdisplayinfo \
	testdraw \
	testdrawchessboard \
	testdropfile \
	testerror \
	testfile \
	testfilesystem \
	testgeometry \
	testgl \
	testgles \
	testgles2 \
	testhaptic \
	testhittesting \
	testhotplug \
	testiconv \
	testime \
	testintersections \
	testkeys \
	testloadso \
	testlocale \
	testlock \
	testmessage \
	testmouse \
	testmultiaudio \
	testoffscreen \
	testoverlay \
	testpen \
	testplatform \
	testpower \
	testprocess \
	testqsort \
	testrelative \
	testrendercopyex \
	testrendertarget \
	testresample \
	testrumble \
	testrwlock \
	testscale \
	testsem \
	testsensor \
	testshader \
	testshape \
	testsprite \
	testspriteminimal \
	testspritesurface \
	teststreaming \
	testsurround \
	testthread \
	testtime \
	testtimer \
	testurl \
	testver \
	testviewport \
	testvulkan \
	testwm \
	testyuv \
	torturethread \

all: $(TARGETS)

checkkeys: checkkeys.o
	$(CXX) -o $@ $^ $(LIBS)
	../../xcoff2app.sh $@

